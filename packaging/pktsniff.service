[Unit]
Description=pktsniff packet capture server
Documentation=https://github.com/Bas3line/packets
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Edit ExecStart to match your interface, filter and recording path.
# Capturing needs CAP_NET_RAW (and CAP_NET_ADMIN for promiscuous mode).
ExecStart=/usr/local/bin/pktsniff-server -i any -p 8888 -t 30 -q
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Add `ReadWritePaths=/var/cap` if you use -w /var/cap/x.pcap
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pktsniff

[Install]
WantedBy=multi-user.target
